platform :osx, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)

    # Required for flutter_gemma LiteRT-LM on desktop
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '13.0'
    end
  end

  # Setup LiteRT-LM companion frameworks on macOS (avoids JIT native assets issue)
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_targets.each do |user_target|
      phase_name = '[flutter_gemma] Setup LiteRT-LM macOS'

      unless user_target.name == 'Runner'
        user_target.build_phases
          .select { |p| p.respond_to?(:name) && p.name == phase_name }
          .each { |p| user_target.build_phases.delete(p) }
        next
      end

      existing = user_target.shell_script_build_phases.find { |p| p.name == phase_name }
      phase = existing || user_target.new_shell_script_build_phase(phase_name)
      phase.always_out_of_date = '1'
      phase.output_paths = ['$(DERIVED_FILE_DIR)/flutter_gemma_litertlm_macos.stamp']
      phase.input_paths = [
        '$(BUILT_PRODUCTS_DIR)/$(PRODUCT_NAME).app/Contents/Frameworks/LiteRtLm.framework/Versions/A/LiteRtLm',
      ]
      phase.shell_script = "\"${SRCROOT}/scripts/setup_litertlm_macos.sh\"\n\"${SRCROOT}/scripts/setup_aurascribe_runtime.sh\"\n"
    end
  end
end

# Keep dependency-cache binaries immutable. Some published sherpa dylibs carry
# signatures invalidated by their universal-binary assembly; macOS can SIGKILL
# rsync when it mmaps the original inode. Stage byte copies inside this project
# and sign those copies before CocoaPods embeds them in the app.
post_integrate do |installer|
  require 'fileutils'
  project_dir = File.expand_path(__dir__)
  source_relative = '../Flutter/ephemeral/.symlinks/plugins/sherpa_onnx_macos/macos'
  staged_relative = '../Flutter/ephemeral/aurascribe_native/sherpa_onnx'
  source_dir = File.expand_path(source_relative, installer.sandbox.root.to_s)
  staged_dir = File.expand_path(staged_relative, installer.sandbox.root.to_s)
  FileUtils.mkdir_p(staged_dir)
  Dir.glob(File.join(source_dir, '*.dylib')).each do |source|
    target = File.join(staged_dir, File.basename(source))
    temporary = "#{target}.tmp"
    IO.copy_stream(source, temporary)
    File.rename(temporary, target)
    unless system('/usr/bin/codesign', '--force', '--sign', '-', target) &&
           system('/usr/bin/codesign', '--verify', '--strict', target)
      raise "Could not prepare project-local native dependency: #{target}"
    end
  end
  support_dir = File.join(installer.sandbox.root.to_s, 'Target Support Files', 'Pods-Runner')
  Dir.glob(File.join(support_dir, 'Pods-Runner-frameworks*')).each do |file|
    next unless File.file?(file)
    source = File.read(file)
    updated = source.gsub(source_relative, staged_relative)
    File.write(file, updated) if updated != source
  end
end
